{
  "op": "project",
  "columns": [
    "e.name",
    "d.dname"
  ],
  "child": {
    "op": "nested_loop_join",
    "condition": "e.did = d.did",
    "left": {
      "op": "project",
      "columns": [
        "d.did",
        "d.dname"
      ],
      "child": {
        "op": "filter",
        "condition": "d.budget > 100000",
        "child": {
          "op": "rename",
          "to": "d",
          "child": {
            "op": "seqscan",
            "table": "Dept"
          }
        }
      }
    },
    "right": {
      "op": "project",
      "columns": [
        "e.name",
        "e.did"
      ],
      "child": {
        "op": "filter",
        "condition": "e.age > 60",
        "child": {
          "op": "rename",
          "to": "e",
          "child": {
            "op": "seqscan",
            "table": "Emp"
          }
        }
      }
    }
  }
}