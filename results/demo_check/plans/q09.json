{
  "op": "project",
  "columns": [
    "e.name",
    "p.pname",
    "w.hours"
  ],
  "child": {
    "op": "hash_join",
    "condition": "w.eid = e.eid",
    "left": {
      "op": "project",
      "columns": [
        "p.pname",
        "w.eid",
        "w.hours"
      ],
      "child": {
        "op": "nested_loop_join",
        "condition": "w.pid = p.pid",
        "left": {
          "op": "project",
          "columns": [
            "p.pid",
            "p.pname"
          ],
          "child": {
            "op": "filter",
            "condition": "p.budget > 90000",
            "child": {
              "op": "rename",
              "to": "p",
              "child": {
                "op": "seqscan",
                "table": "Proj"
              }
            }
          }
        },
        "right": {
          "op": "project",
          "columns": [
            "w.eid",
            "w.pid",
            "w.hours"
          ],
          "child": {
            "op": "rename",
            "to": "w",
            "child": {
              "op": "seqscan",
              "table": "Works"
            }
          }
        }
      }
    },
    "right": {
      "op": "project",
      "columns": [
        "e.eid",
        "e.name"
      ],
      "child": {
        "op": "rename",
        "to": "e",
        "child": {
          "op": "seqscan",
          "table": "Emp"
        }
      }
    }
  }
}