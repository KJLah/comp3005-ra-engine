{
  "op": "project",
  "columns": [
    "e.name",
    "d.dname",
    "p.pname"
  ],
  "child": {
    "op": "nested_loop_join",
    "condition": "w.pid = p.pid",
    "left": {
      "op": "project",
      "columns": [
        "d.dname",
        "e.name",
        "w.pid"
      ],
      "child": {
        "op": "nested_loop_join",
        "condition": "e.eid = w.eid",
        "left": {
          "op": "project",
          "columns": [
            "d.dname",
            "e.eid",
            "e.name"
          ],
          "child": {
            "op": "nested_loop_join",
            "condition": "e.did = d.did",
            "left": {
              "op": "project",
              "columns": [
                "d.did",
                "d.dname"
              ],
              "child": {
                "op": "filter",
                "condition": "d.budget < 50000",
                "child": {
                  "op": "rename",
                  "to": "d",
                  "child": {
                    "op": "seqscan",
                    "table": "Dept"
                  }
                }
              }
            },
            "right": {
              "op": "project",
              "columns": [
                "e.eid",
                "e.name",
                "e.did"
              ],
              "child": {
                "op": "rename",
                "to": "e",
                "child": {
                  "op": "seqscan",
                  "table": "Emp"
                }
              }
            }
          }
        },
        "right": {
          "op": "project",
          "columns": [
            "w.eid",
            "w.pid"
          ],
          "child": {
            "op": "filter",
            "condition": "w.hours > 30",
            "child": {
              "op": "rename",
              "to": "w",
              "child": {
                "op": "seqscan",
                "table": "Works"
              }
            }
          }
        }
      }
    },
    "right": {
      "op": "project",
      "columns": [
        "p.pid",
        "p.pname"
      ],
      "child": {
        "op": "rename",
        "to": "p",
        "child": {
          "op": "seqscan",
          "table": "Proj"
        }
      }
    }
  }
}