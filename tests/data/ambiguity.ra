// GRAMMAR.md 5.3: instances where the two groupings give different answers.

// Test 10: A union B minus C
//   (A union B) minus C = {2}      <- our grammar
//   A union (B minus C) = {1, 2}
A (x) = {
  1
}
B (x) = {
  2
}
C (x) = {
  1
}

// Test 11: A2 minus B2 minus C2
//   (A2 minus B2) minus C2 = {2, 3}      <- our grammar
//   A2 minus (B2 minus C2) = {1, 2, 3}
A2 (x) = {
  1
  2
  3
}
B2 (x) = {
  1
}
C2 (x) = {
  1
}
